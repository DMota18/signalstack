# SignalStack — Environment Variables
# Copy to .env and fill in real values. Never commit .env to version control.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Encryption — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# Claude API
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# Redis (Celery broker + result backend)
# Use redis://redis:6379/0 when running in Docker (container hostname)
# Use redis://localhost:6379/0 when running locally
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=changeme-generate-a-real-password

# ─── APP CONFIG ──────────────────────────────────────────────────────────────

APP_ENV=production
DEBUG=false

# Domain for Caddy auto-HTTPS (used in docker-compose.prod.yml)
DOMAIN=yourdomain.com

# CORS — comma-separated list of allowed origins.
# Set this to your actual domain. Used in production (when DEBUG=false).
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── DATA PROVIDERS ──────────────────────────────────────────────────────────

# Finnhub (free tier: finnhub.io) — live stock quotes, day changes
FINNHUB_API_KEY=your-finnhub-key

# FRED (free: fred.stlouisfed.org) — macro economic data
FRED_API_KEY=your-fred-key

# Alpha Vantage (free tier: alphavantage.co) — technical indicators
ALPHA_VANTAGE_API_KEY=

# NewsAPI (free tier: newsapi.org) — market headlines
NEWSAPI_API_KEY=

# Unusual Whales (paid: unusualwhales.com) — congressional trades, options flow
UNUSUAL_WHALES_API_KEY=

# Polymarket Gamma API: no key needed (free, unauthenticated)
# Fear & Greed Index: no key needed (free endpoint)
# Yahoo Finance (yfinance): no key needed (free)

# ─── BROKERAGE CONNECTION ────────────────────────────────────────────────────

# SnapTrade — brokerage sync (optional for demo, users add holdings manually without it)
SNAPTRADE_CLIENT_ID=your-snaptrade-client-id
SNAPTRADE_CONSUMER_KEY=your-snaptrade-consumer-key

# ─── NOTIFICATIONS (optional) ────────────────────────────────────────────────

# VAPID / Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=admin@yourdomain.com

# Email (Resend — recommended) — sign up at resend.com
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Zelador Analytics <noreply@yourdomain.com>

# Email (SMTP — legacy fallback, used only if RESEND_API_KEY is empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
